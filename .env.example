# =============================================================
# .env.example — Environment Variable Template
# =============================================================
# COPY this file to .env and fill in real values.
# The .env file is NEVER committed to Git.
#
# Command: copy .env.example .env  (Windows)
#          cp .env.example .env    (Linux/Mac)
# =============================================================

# =============================================================
# DJANGO CORE
# =============================================================

# Generate a new secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-new-one

# Settings module to use
DJANGO_SETTINGS_MODULE=config.settings.development

# Enable/disable debug mode (True for development, False for production)
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================
# DATABASE — PostgreSQL (local development)
# =============================================================

# Database name (create this in PostgreSQL: CREATE DATABASE crm_platform;)
DATABASE_NAME=crm_platform

# Database user (create: CREATE USER crm_user WITH PASSWORD 'yourpassword';)
DATABASE_USER=crm_user

# Database password
DATABASE_PASSWORD=your-db-password-here

# Database host (localhost for local PostgreSQL)
DATABASE_HOST=localhost

# PostgreSQL default port
DATABASE_PORT=5432

# Separate database for running tests (pytest-django creates/drops it automatically)
TEST_DATABASE_NAME=crm_platform_test

# =============================================================
# REDIS (Phase 8 — DO NOT CONFIGURE YET)
# =============================================================
# REDIS_URL=redis://localhost:6379/0

# =============================================================
# CELERY (Phase 8 — DO NOT CONFIGURE YET)
# =============================================================
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=django-db

# =============================================================
# JWT (Phase 3 — DO NOT CONFIGURE YET)
# =============================================================
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================
# AI PROVIDERS (Phase 11 — DO NOT CONFIGURE YET)
# =============================================================
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# =============================================================
# AWS (Phase 14 — DO NOT CONFIGURE YET)
# =============================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=
