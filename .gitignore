# =============================================================
# .gitignore — Files that must NEVER be committed to Git
# =============================================================

# =============================================================
# SECRETS AND ENVIRONMENT — CRITICAL
# The .env file contains passwords, secret keys, API keys.
# Committing it would expose credentials to everyone with repo access.
# =============================================================
.env
*.env
.env.local
.env.production
.env.staging

# =============================================================
# PYTHON
# =============================================================
# Virtual environment — contains installed packages (not source code)
.venv/
venv/
env/

# Python bytecode cache — auto-generated, not needed in repo
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
MANIFEST

# Python test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc

# MyPy type checking cache
.mypy_cache/

# =============================================================
# DJANGO
# =============================================================
# Collected static files (generated by collectstatic)
staticfiles/
static_root/

# Django media uploads
media/
uploads/

# Django local database (SQLite — we use PostgreSQL, but just in case)
db.sqlite3
*.sqlite3

# =============================================================
# EDITOR / IDE
# =============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================================
# OPERATING SYSTEM
# =============================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# =============================================================
# LOGS
# =============================================================
*.log
logs/

# =============================================================
# TEMPORARY / SCRATCH FILES
# =============================================================
*.tmp
*.bak
*.swp
scratch/
tmp/
